# ---------------------------------------------------------------------------
# Rescue Rituals Events API — environment template
#
# Copy to `.env` for local development. Never commit a real `.env`.
# Production values are supplied by the hosting platform, not this file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# PostgreSQL connection string.
#
# `connection_limit` is set explicitly because the RSVP capacity transaction
# holds a row lock while it runs: under a concurrency burst the pool, not the
# database, is the first thing to saturate. Keep it comfortably above the
# number of RSVP requests you expect to have in flight at once.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rescue_rituals_events?schema=public&connection_limit=20&pool_timeout=20"

# Authentication. Generate a strong secret, e.g. `openssl rand -base64 48`.
# The application refuses to start in production with a short or default value.
JWT_SECRET="replace-me-with-a-long-random-development-secret-at-least-32-chars"
JWT_EXPIRES_IN="1h"

# Comma-separated list of allowed browser origins. `*` is rejected when
# NODE_ENV=production.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL milliseconds,
# counted per authenticated user (or per IP when anonymous).
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Register/login. Tight on purpose: each attempt costs an Argon2 hash and gives
# an attacker a free guess.
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10

# RSVP and cancel. Generous enough for real bursts, low enough to stop one
# account monopolising an event.
RSVP_THROTTLE_TTL=60000
RSVP_THROTTLE_LIMIT=30

# Set to true when running behind a reverse proxy / platform load balancer so
# rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=false
