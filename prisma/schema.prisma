// Rescue Rituals Events Platform — database schema.
//
// Naming: camelCase in TypeScript, snake_case in PostgreSQL (via @map/@@map),
// camelCase in API JSON. See docs/ENGINEERING_STANDARDS.md §5.
//
// CHECK constraints cannot be expressed in the Prisma schema language. The
// domain invariants from docs/DATA_MODEL.md §4 are therefore added as raw SQL
// in the migration itself — see
// prisma/migrations/*_init/migration.sql. Do not assume the invariants below
// are enforced just because they are documented here; they are enforced
// because that SQL ran.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  ADOPTION_EVENT
  RESCUE_FAIR
  FOSTER_WORKSHOP
  VOLUNTEER_EVENT
  COMMUNITY_MEETUP
  OTHER

  @@map("event_type")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED

  @@map("event_status")
}

enum RsvpStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED

  @@map("rsvp_status")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  /// Stored lowercased and trimmed. See docs/DATA_MODEL.md §3 for the
  /// normalisation policy and its documented limits.
  email        String   @unique @db.VarChar(255)
  /// Argon2id hash. Never selected into an API response — see
  /// src/users/dto/user-response.dto.ts.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdEvents      Event[]             @relation("EventCreator")
  rsvps              Rsvp[]
  idempotencyRecords IdempotencyRecord[]

  @@map("users")
}

model Event {
  id             String      @id @default(uuid()) @db.Uuid
  title          String      @db.VarChar(160)
  description    String      @db.Text
  eventType      EventType   @default(OTHER) @map("event_type")
  status         EventStatus @default(PUBLISHED)
  location       String      @db.VarChar(255)
  startsAt       DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime    @map("ends_at") @db.Timestamptz(3)
  /// IANA zone such as `America/New_York`. Stored for display only; all
  /// instants are persisted as TIMESTAMPTZ and no conversion is performed
  /// server-side.
  timezone       String?     @db.VarChar(64)
  /// NULL means unlimited. A positive integer caps CONFIRMED rsvps.
  capacity       Int?
  /// Whether a full event queues further requests instead of rejecting them.
  /// Has no effect when `capacity` is NULL, since such an event is never full.
  waitlistEnabled Boolean @default(true) @map("waitlist_enabled")
  /// Denormalised count of CONFIRMED rsvps, maintained inside the same
  /// transaction as the rsvp row it counts (ADR-007). The rsvps table remains
  /// the source of truth; this column exists so event list reads are O(1).
  confirmedCount Int         @default(0) @map("confirmed_count")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User   @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rsvps     Rsvp[]

  // Supports the default listing query: upcoming events sorted by start time.
  @@index([startsAt])
  // Supports "events I organise" and the ownership lookup on mutation.
  @@index([createdById])
  // Supports the listing query once `status` is filtered, which is the common
  // case (only PUBLISHED events are publicly discoverable).
  @@index([status, startsAt])
  @@map("events")
}

model Rsvp {
  id      String     @id @default(uuid()) @db.Uuid
  eventId String     @map("event_id") @db.Uuid
  userId  String     @map("user_id") @db.Uuid
  status  RsvpStatus

  /// When the user entered the waitlist queue, and the primary waitlist
  /// ordering key. This is deliberately NOT `createdAt`: a user who cancels
  /// and later re-joins reuses this row, and ordering by `createdAt` would
  /// hand them their original queue priority back. NULL when not waitlisted.
  queuedAt DateTime? @map("queued_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One rsvp row per (event, user), for all time. Cancelling transitions this
  /// row to CANCELLED rather than deleting it, and re-joining transitions it
  /// back — so this constraint is the final guard against duplicate
  /// membership even under concurrent requests (ADR-006).
  @@unique([eventId, userId])
  // Supports the attendee listing and the waitlist promotion probe, which
  // reads (event_id, status) ordered by the queue keys.
  @@index([eventId, status, queuedAt, id])
  // Supports "events I am attending".
  @@index([userId, status])
  @@map("rsvps")
}

/// Stored result of a mutating request that carried an `Idempotency-Key`, so
/// that a client retrying after a network timeout observes the original
/// outcome instead of a second side effect or a spurious 409.
///
/// Scoped to the authenticated user so one client's key can never replay
/// another's response.
model IdempotencyRecord {
  id          String @id @default(uuid()) @db.Uuid
  key         String @db.VarChar(255)
  userId      String @map("user_id") @db.Uuid
  /// Logical operation the key applies to, e.g. `POST:/events/:id/rsvp`.
  scope       String @db.VarChar(160)
  /// Hash of the request's meaningful inputs. Reusing a key with different
  /// inputs is a client bug and is rejected with 422 rather than silently
  /// returning an unrelated stored response.
  requestHash String @map("request_hash") @db.VarChar(64)

  statusCode   Int  @map("status_code")
  responseBody Json @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  // Supports periodic pruning of expired records.
  @@index([createdAt])
  @@map("idempotency_records")
}
