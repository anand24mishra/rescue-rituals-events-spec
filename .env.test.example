# Template for the integration/e2e test environment.
#
# Copy to `.env.test`. This must point at a DISPOSABLE database: the e2e suite
# truncates every table between spec files.
#
# The rate limit is deliberately raised so throttling does not interfere with
# the concurrency test; the dedicated throttling spec overrides it locally.
NODE_ENV=test
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rescue_rituals_events_test?schema=public&connection_limit=30&pool_timeout=20"
JWT_SECRET="test-only-secret-not-used-outside-automated-tests-32chars"
JWT_EXPIRES_IN="1h"
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL=silent
THROTTLE_TTL=60000
THROTTLE_LIMIT=100000
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=100000
RSVP_THROTTLE_TTL=60000
RSVP_THROTTLE_LIMIT=100000
TRUST_PROXY=false
